generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  published
  discontinued
  draft
}

enum OrderStatus {
  pending
  paid
  shipped
  delivered
  cancelled
}

enum UserRole {
  admin
  customer
}

model Product {
  id               String        @id @unique @default(uuid())
  sku              String        @unique
  name             String
  shortDescription String
  longDescription  String?
  brand            String?
  price            Decimal       @db.Decimal(10, 2)
  tax              Int?          @default(21)
  stock            Int           @default(0)
  status           ProductStatus @default(draft)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  images    Image[]
  cartItem  CartItem[]
  orderItem OrderItem[]

  categories Category[] @relation("ProductCategories")

  mainCategory   Category? @relation("MainCategory", fields: [mainCategoryId], references: [id])
  mainCategoryId String?

  // Stored, DB-generated full-text search vector (see migration). Managed entirely
  // in SQL; exposed here only so Prisma is aware of the column and its GIN index.
  searchVector Unsupported("tsvector")?

  @@index([mainCategoryId])
  @@index([status])
  @@index([createdAt])
  @@index([price])
  @@index([searchVector], type: Gin)
}

model Image {
  id     String  @id @default(uuid())
  url    String
  isMain Boolean @default(false)

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId])
}

model Category {
  id   String @id @default(uuid())
  name String @unique

  products     Product[] @relation("ProductCategories")
  mainProducts Product[] @relation("MainCategory")
}

model User {
  id       String   @id @unique @default(uuid())
  email    String   @unique
  password String
  name     String
  role     UserRole @default(customer)

  cart      Cart?
  orders    Order[]
  addresses Address[]

  // Soft delete: null = activo, con fecha = "borrado". Filtrar en todas las lecturas.
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deletedAt])
}

model Cart {
  id String @id @unique @default(uuid())

  cartItems CartItem[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id       String @id @unique @default(uuid())
  quantity Int

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId String

  @@unique([cartId, productId])
  @@index([productId])
}

model Order {
  id          String      @id @unique @default(uuid())
  orderNumber Int @default(autoincrement()) @unique
  status      OrderStatus @default(pending)
  totalAmount Decimal     @db.Decimal(10, 2)

  orderItems OrderItem[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String

  shippingAddress   Address? @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: Restrict)
  shippingAddressId String?
  
  billingAddress   Address? @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: Restrict)
  billingAddressId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id              String  @id @unique @default(uuid())
  skuAtPurchase   String
  nameAtPurchase  String
  priceAtPurchase Decimal @db.Decimal(10, 2)
  quantity        Int

  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  @@index([orderId])
  @@index([productId])
}

model Address {
  id String @id @default(uuid())

  fullName   String
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String

  // Libreta de direcciones del usuario. Null = es una copia congelada usada por una orden.
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?

  // Órdenes que apuntan a esta dirección (copias congeladas).
  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
