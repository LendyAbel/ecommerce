enum OrderStatus {
  pending
  paid
  shipped
  delivered
  cancelled
  refunded
}

model Order {
  id          String      @id @unique @default(uuid())
  orderNumber Int         @unique @default(autoincrement())
  status      OrderStatus @default(pending)
  totalAmount Decimal     @db.Decimal(10, 2)

  orderItems OrderItem[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId String

  shippingAddress   Address? @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: Restrict)
  shippingAddressId String?

  billingAddress   Address? @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: Restrict)
  billingAddressId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id              String  @id @unique @default(uuid())
  skuAtPurchase   String
  nameAtPurchase  String
  priceAtPurchase Decimal @db.Decimal(10, 2)
  quantity        Int

  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String

  @@index([orderId])
  @@index([productId])
}
