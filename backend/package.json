{
    "name": "backend",
    "version": "1.0.0",
    "description": "ecommerce-backend",
    "license": "MIT",
    "author": "lendy",
    "type": "commonjs",
    "main": "index.ts",
    "scripts": {
        "dev": "nodemon --exec ts-node src/index.ts",
        "dev:clean": "npx kill-port 3001 && nodemon --exec ts-node src/index.ts",
        "seed": "npx prisma migrate reset && ts-node prisma/seed.ts",
        "reset-db": "npx prisma migrate reset",
        "build": "tsc",
        "start": "node dist/index.js"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.4.2",
        "@prisma/client": "^7.5.0",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.20.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.3.3",
        "@types/pg": "^8.18.0",
        "eslint": "^10.0.2",
        "nodemon": "^3.1.14",
        "prisma": "^7.5.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1"
    }
}
