{
    "name": "backend",
    "version": "1.0.0",
    "description": "ecommerce-backend",
    "license": "MIT",
    "author": "lendy",
    "type": "commonjs",
    "main": "index.ts",
    "scripts": {
        "dev": "nodemon --exec ts-node src/index.ts",
        "dev:clean": "npx kill-port 3001 && nodemon --exec ts-node src/index.ts",
        "seed": "npx prisma migrate reset && ts-node prisma/seed.ts",
        "reset-db": "npx prisma migrate reset",
        "build": "tsc",
        "start": "node dist/src/index.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.4.2",
        "@prisma/client": "^7.5.0",
        "bcrypt": "^6.0.0",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "helmet": "^8.2.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.20.0",
        "pino": "^10.3.1",
        "pino-http": "^11.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.3.3",
        "@types/pg": "^8.18.0",
        "@types/supertest": "^7.2.0",
        "eslint": "^10.0.2",
        "jest": "^30.3.0",
        "jest-mock-extended": "^4.0.1",
        "nodemon": "^3.1.14",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.8.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.9",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.1"
    }
}
